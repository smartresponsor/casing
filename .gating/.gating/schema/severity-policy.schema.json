{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartresponsor.local/schema/gating/severity-policy.schema.json",
  "title": "Gating severity policy",
  "type": "object",
  "required": ["severity"],
  "properties": {
    "severity": {
      "type": "object",
      "required": ["default", "rules"],
      "properties": {
        "default": { "enum": ["error", "warning", "info"] },
        "rules": {
          "type": "object",
          "additionalProperties": { "enum": ["error", "warning", "info"] }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
