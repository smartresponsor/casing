{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gating profile",
  "type": "object",
  "properties": {
    "component": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "nameEntity": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "business_prefix": {
          "type": "string"
        },
        "database_prefix": {
          "type": "string"
        },
        "route_owner_root": {
          "type": "string"
        },
        "route_owner_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typed_layers_required": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "service_interface_mirror": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "mutation_mode": {
          "enum": [
            "forbidden",
            "plan",
            "allowed"
          ]
        },
        "secret_scan": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "docblock_preservation": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "release": {
          "type": "object",
          "properties": {
            "evidence_required": {
              "type": [
                "boolean",
                "string"
              ]
            },
            "required_files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "typed_layer_map": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "secret_scan_excluded_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_excluded_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_excluded_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_excluded_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inventory_excluded_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
