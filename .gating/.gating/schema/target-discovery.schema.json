{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gating.target.discovery.v1",
  "title": "Gating target discovery report",
  "type": "object",
  "required": ["schema", "tool", "generated_at", "root", "summary", "targets"],
  "properties": {
    "schema": { "const": "gating.target.discovery.v1" },
    "tool": { "const": "gating/gate" },
    "generated_at": { "type": "string" },
    "root": { "type": "string" },
    "max_depth": { "type": "integer", "minimum": 0 },
    "summary": {
      "type": "object",
      "required": ["total", "with_composer", "with_src", "with_gating"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "with_composer": { "type": "integer", "minimum": 0 },
        "with_src": { "type": "integer", "minimum": 0 },
        "with_gating": { "type": "integer", "minimum": 0 }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "relative_path", "has_composer", "has_src", "has_gating"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "relative_path": { "type": "string" },
          "has_composer": { "type": "boolean" },
          "has_src": { "type": "boolean" },
          "has_gating": { "type": "boolean" },
          "profile_candidate": { "type": ["string", "null"] }
        }
      }
    }
  }
}
