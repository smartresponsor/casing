{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gating.baseline.v1",
  "title": "Gating baseline report",
  "type": "object",
  "required": ["schema", "tool", "generated_at", "root", "summary", "items"],
  "properties": {
    "schema": { "const": "gating.baseline.v1" },
    "tool": { "const": "gating/gate" },
    "generated_at": { "type": "string" },
    "root": { "type": "string" },
    "summary": {
      "type": "object",
      "required": ["targets", "failed", "passed", "skipped"],
      "properties": {
        "targets": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "items": { "type": "array" }
  }
}
