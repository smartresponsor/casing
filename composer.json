{
  "name": "casing/case",
  "description": "SmartResponsor case intake and lifecycle component",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "attaching/attachment": "*@dev",
    "cataloging/catalog": "*@dev",
    "cruding/crud": "*@dev",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "interfacing/interface": "*@dev",
    "objecting/object": "*@dev",
    "ordering/order": "*@dev",
    "paying/payment": "*@dev",
    "shipping/shipment": "*@dev",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "*@dev"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\Casing\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Casing\\Tests\\": "tests/"}},
  "repositories": [
    {"type": "path", "url": "../Administering", "options": {"symlink": true}},
    {"type": "path", "url": "../Attaching", "options": {"symlink": true}},
    {"type": "path", "url": "../Cataloging", "options": {"symlink": true}},
    {"type": "path", "url": "../Cruding", "options": {"symlink": true}},
    {"type": "path", "url": "../Interfacing", "options": {"symlink": true}},
    {"type": "path", "url": "../Navigating", "options": {"symlink": true}},
    {"type": "path", "url": "../Objecting", "options": {"symlink": true}},
    {"type": "path", "url": "../Ordering", "options": {"symlink": true}},
    {"type": "path", "url": "../Paying", "options": {"symlink": true}},
    {"type": "path", "url": "../Shipping", "options": {"symlink": true}},
    {"type": "path", "url": "../Viewing", "options": {"symlink": true}}
  ],
  "scripts": {
    "cs:check": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "cs:fix": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "test": "php vendor/bin/phpunit -c phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": {"symfony/runtime": true},
    "sort-packages": true
  },
  "extra": {"symfony": {"bundle": "App\\Casing\\CasingBundle"}},
  "minimum-stability": "dev",
  "prefer-stable": true
}
