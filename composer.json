{
  "name": "casing/case",
  "description": "SmartResponsor case intake and lifecycle component",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "attaching/attachment": "dev-master",
    "cataloging/catalog": "dev-master",
    "cruding/crud": "dev-master",
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "ordering/order": "dev-master",
    "paying/payment": "dev-master",
    "relating/relation": "dev-master",
    "shipping/shipment": "dev-master",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\Casing\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Casing\\Tests\\": "tests/"}},
  "repositories": [
    {"type": "path", "url": "../Administering", "options": {"symlink": true, "versions": {"administering/administration": "dev-master"}}},
    {"type": "path", "url": "../Attaching", "options": {"symlink": true, "versions": {"attaching/attachment": "dev-master"}}},
    {"type": "path", "url": "../Cataloging", "options": {"symlink": true, "versions": {"cataloging/catalog": "dev-master"}}},
    {"type": "path", "url": "../Collectioning", "options": {"symlink": true, "versions": {"collectioning/collection": "dev-master"}}},
    {"type": "path", "url": "../Cruding", "options": {"symlink": true, "versions": {"cruding/crud": "dev-master"}}},
    {"type": "path", "url": "../Interfacing", "options": {"symlink": true, "versions": {"interfacing/interface": "dev-master"}}},
    {"type": "path", "url": "../Navigating", "options": {"symlink": true, "versions": {"navigating/navigation": "dev-master"}}},
    {"type": "path", "url": "../Objecting", "options": {"symlink": true, "versions": {"objecting/object": "dev-master"}}},
    {"type": "path", "url": "../Ordering", "options": {"symlink": true, "versions": {"ordering/order": "dev-master"}}},
    {"type": "path", "url": "../Paying", "options": {"symlink": true, "versions": {"paying/payment": "dev-master"}}},
    {"type": "path", "url": "../Relating", "options": {"symlink": true, "versions": {"relating/relation": "dev-master"}}},
    {"type": "path", "url": "../Shipping", "options": {"symlink": true, "versions": {"shipping/shipment": "dev-master"}}},
    {"type": "path", "url": "../Tabling", "options": {"symlink": true, "versions": {"tabling/table": "dev-master"}}},
    {"type": "path", "url": "../Viewing", "options": {"symlink": true, "versions": {"viewing/view": "dev-master"}}}
  ],
  "scripts": {
    "cs:check": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "cs:fix": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "phpstan": "php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit -c phpunit.xml.dist --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "test": "php vendor/bin/phpunit -c phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": {"symfony/runtime": true},
    "sort-packages": true
  },
  "extra": {"symfony": {"bundle": "App\\Casing\\CasingBundle"}},
  "minimum-stability": "dev",
  "prefer-stable": true
}
