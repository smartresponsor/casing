parameters:
    level: 5
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    treatPhpDocTypesAsCertain: false
    scanDirectories:
        - vendor/relating/relation/src
    ignoreErrors:
        -
            identifier: property.unusedType
            path: src/Entity/*
        -
            identifier: property.onlyWritten
            path: src/Entity/CaseOutboxMessageEntity.php
